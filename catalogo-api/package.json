{
  "name": "catalogo-productos-api",
  "version": "1.0.0",
  "description": "API REST de catálogo de productos y favoritos con roles y JWT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql \"$DATABASE_URL\" -f sql/schema.sql",
    "db:seed": "node scripts/seed-products.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": { "nodemon": "^3.1.7" }
}
