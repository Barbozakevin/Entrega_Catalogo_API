  "item": [
    {
      "name": "00 - Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado HTTP 200\", () => pm.response.to.have.status(200));",
              "const j=pm.response.json(); pm.environment.set(\"adminToken\", j.data.token); pm.test(\"Token y rol admin\",()=>{pm.expect(j.data.token).to.be.a(\"string\");pm.expect(j.data.user.role).to.eql(\"administrador\");});"
            ]
          }
        }
      ]
    },
